# Local SQLite file, relative to the project root or absolute. No database server required.
DATABASE_URL=.local/coworkerz.sqlite

# --- Phase 0: authentication (required) -------------------------------------
# Signs the session cookie. At least 32 characters. Generate one with:
#   node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
# Without it every request returns 503 rather than granting anonymous CEO access.
CW_SESSION_SECRET=
# The single-operator sign-in code for this installation. Rotate after sharing a screen.
CEO_ACCESS_CODE=
# Seals provider API keys before they are written to SQLite (AES-256-GCM). Keep this
# OUTSIDE the database volume and in the secret manager of the deployment platform.
CW_SECRET_KEY=

# Set to 1 ONLY for a local demo. Ignored in production, where it fails closed instead.
CW_AUTH_DISABLED=0
# Provider requests allowed per process per minute. Blank defaults to 30.
CW_PROVIDER_RATE_LIMIT=30

# Optional server-side settings. The seed takes the initial base URL from here.
# Env keys are resolved at runtime; only keys explicitly saved via the UI enter the DB.
# Console (pay-as-you-go). For an eligible Go workload use https://opencode.ai/inference/go/openai/v1.
OPENCODE_BASE_URL=https://opencode.ai/inference/openai/v1
OPENCODE_API_KEY=
# Optional, server only. Match a full base URL; never commit secret values. See docs/model-gateways.md.
OPENCODE_HEADER_RULES='{}'
# Example: OPENCODE_HEADER_RULES='{"https://gateway.example/v1":[{"name":"X-Client-Tag","type":"static","value":"cw-boardroom","prefix":"cw-"},{"name":"X-Request-ID","type":"sequence","prefix":"req_"}]}'
OPENAI_API_KEY=
# Set to 1 to keep prompts local and disable all OpenCode completions/diagnostics.
OPENCODE_OFFLINE=0

# Best-effort exports; SQLite is authoritative. Keep test outputs out of tracked examples.
MEMORY_DIR=.local/memory
KNOWLEDGE_DIR=.local/knowledge
