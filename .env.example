# Local development only. Replace the connection details with a disposable PostgreSQL DB.
DATABASE_URL=postgresql://dev_user:replace_me@127.0.0.1:5432/coworkerz_dev

# Optional server-side settings. The first initialization seeds the base URL/key into
# opencode_configs; thereafter check the saved settings in the UI (do not publish DB dumps).
OPENCODE_BASE_URL=https://opencode.ai/inference/openai/v1
OPENCODE_API_KEY=
# Alternative key consulted by the live completion client if no saved/OpenCode key is set.
OPENAI_API_KEY=

# Keep local persona, journal and transcript mirrors out of the tracked memory/ samples.
MEMORY_DIR=.local/memory
